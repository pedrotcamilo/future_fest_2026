# Ordem de preferencia do load balancer (round-robin com failover).
# Ex.: "gemini,groq" ou "groq,gemini"
AI_PROVIDERS_ORDER="gemini,groq"
AI_TIMEOUT="60"
# Circuit breaker: apos N falhas consecutivas o provedor sai da rota e o
# outro assume 100% ate o provedor se recuperar (cooldown em segundos).
AI_MAX_FALHAS="2"
AI_COOLDOWN_SEGUNDOS="120"

TIMEZONE=""